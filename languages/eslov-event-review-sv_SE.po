#. Description of the plugin
#: eslov-event-review.php
msgid "Event submission review and restrictions for organizer accounts."
msgstr "Lokal granskning av evenemang och begränsning av formulärkonton."

#: eslov-event-review.php:34
msgid "Activate Eslöv Event Review separately on each site."
msgstr "Aktivera Eslöv Event Review separat på varje webbplats."

#: eslov-event-review.php:40
msgid "Event review"
msgstr "Granskning av evenemang"

#: eslov-event-review.php:43
msgid "Forms requiring review"
msgstr "Formulär som kräver granskning"

#: eslov-event-review.php:52
msgid ""
"Select one or more event submission forms. New events are saved as Pending "
"Review without a password. New organizer accounts become subscribers, cannot "
"log in, and receive no welcome emails. Other forms are unaffected. Leave "
"empty to disable review of new submissions."
msgstr ""
"Välj ett eller flera formulär som skickar in evenemang. Nya evenemang sparas "
"som Väntar på granskning utan lösenord. Nya arrangörskonton blir "
"prenumeranter, kan inte logga in och får inga välkomstmejl. Övriga formulär "
"påverkas inte. Lämna tomt för att stänga av granskning av nya inskick."

#. translators: %d: Frontend form module ID.
#: eslov-event-review.php:70
msgid "(ID %d)"
msgstr "(ID %d)"

