msgid "Review"
msgstr "Granskning"

#: eslov-event-review.php:91
msgid "Accept"
msgstr "Acceptera"

#: eslov-event-review.php:91
msgid "Reject"
msgstr "Neka"

#: eslov-event-review.php:95
msgid "Move the event to the Trash?"
msgstr "Flytta evenemanget till papperskorgen?"

#: eslov-event-review.php:99
msgid "Review event"
msgstr "Granska"

#: eslov-event-review.php:119
msgid "The Event Manager organizer handler is unavailable."
msgstr "Event Managers arrangörshanterare saknas."

#: eslov-event-review.php:125
msgid "The event cannot be processed."
msgstr "Evenemanget kan inte behandlas."

#: eslov-event-review.php:135
msgid "The organizer details could not be processed."
msgstr "Arrangörsuppgifterna kunde inte behandlas."

#: eslov-event-review.php:139
msgid "The organizer could not be created. Check the organizer details."
msgstr "Arrangören kunde inte skapas. Kontrollera arrangörsuppgifterna."

#: eslov-event-review.php:145
msgid "This action is not allowed."
msgstr "Åtgärden är inte tillåten."

#: eslov-event-review.php:151
msgid "The event could not be processed."
msgstr "Evenemanget kunde inte behandlas."

#: eslov-event-review.php:178
